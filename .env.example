# Copy to .env and `set -a && . ./.env && set +a` before `cargo run`.
# Everything here maps onto config/default.toml as EXECUTE_<SECTION>__<KEY>.

DATABASE_URL=postgres://execute:execute@127.0.0.1:54350/execute_server
PORT=8080
EXECUTE_PROFILE=local
RUST_LOG=info,sqlx=warn
EXECUTE_LOG_FORMAT=pretty

# Where gum-indexer / gum-engine call back to (private network in production).
EXECUTE_SERVER__CALLBACK_BASE_URL=http://127.0.0.1:8080

# gum-contracts generation (LocalBootstrap.s.sol fixture for Anvil).
EXECUTE_ADDRESSES__FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Privy (the dashboard at execute.cash signs in with it): app id and verification key (PEM).
EXECUTE_PRIVY__APP_ID=
EXECUTE_PRIVY__VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# gum-indexer: base URL and its GUM_WEBHOOK__SECRET.
EXECUTE_INDEXER__BASE_URL=http://127.0.0.1:8081
EXECUTE_INDEXER__WEBHOOK_SECRET=

# gum-engine: base URL (private network; no auth) and its webhook.signing_secret.
EXECUTE_ENGINE__BASE_URL=http://127.0.0.1:8082
EXECUTE_ENGINE__WEBHOOK_SECRET=

# Operator token for /v1/admin routes (empty disables them).
EXECUTE_ADMIN__TOKEN=

# Tests create throwaway databases on this server.
TEST_DATABASE_URL=postgres://execute:execute@127.0.0.1:54350/execute_server
