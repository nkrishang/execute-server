# execute-server: production variables for Railway. Copy to .env.production (gitignored), fill in
# every "<...>", then load them onto the service:
#   railway variables set $(grep -v '^#' .env.production | grep -v '^$' | xargs)
# Railway injects DATABASE_URL (Postgres plugin) and PORT.

# ---- This service -----------------------------------------------------------------------------
# Where gum-indexer and gum-engine call back to: <base>/v1/webhooks/{indexer,engine}. All services
# share one Railway project, so this is the private-network address, never api.execute.cash.
EXECUTE_SERVER__CALLBACK_BASE_URL=http://execute-server.railway.internal:8080
RUST_LOG=info,sqlx=warn,hyper=warn

# ---- The contracts --------------------------------------------------------------------------------
# PaymentFactory of the generation /v1 is pinned to (identical on every chain).
EXECUTE_ADDRESSES__FACTORY_ADDRESS=0x6D85B9706D8f076cB8A9fEA37d70Fcb8D22C2952

# ---- Privy (the execute.cash dashboard's sign-in) -----------------------------------------------
EXECUTE_PRIVY__APP_ID=<privy app id>
EXECUTE_PRIVY__VERIFICATION_KEY="<PEM verification key; literal \n line breaks are fine>"

# ---- gum-indexer (same Railway project, private network; no auth) -------------------------------
# On gum-indexer, allow our private callback host too:
#   GUM_WEBHOOK__HOST_ALLOWLIST=["gum-server.railway.internal","execute-server.railway.internal"]
EXECUTE_INDEXER__BASE_URL=http://gum-indexer.railway.internal:8080
EXECUTE_INDEXER__WEBHOOK_SECRET=<gum-indexer's GUM_WEBHOOK__SECRET>

# ---- gum-engine (same Railway project, private network; no auth) --------------------------------
EXECUTE_ENGINE__BASE_URL=http://gum-engine.railway.internal:8080
EXECUTE_ENGINE__WEBHOOK_SECRET=<gum-engine's webhook signing secret>

# ---- Operator ---------------------------------------------------------------------------------------
# Bearer token for /v1/admin routes. Generate with: openssl rand -hex 32
EXECUTE_ADMIN__TOKEN=<random>
